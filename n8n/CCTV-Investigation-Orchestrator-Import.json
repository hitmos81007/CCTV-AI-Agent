              "requiredField": true
            },
            {
              "fieldLabel": "Jurisdiction adjacency map (JSON)",
              "fieldType": "textarea",
              "fieldName": "neighbors_json",
              "placeholder": "{\"South\":[\"East\",\"West\"],\"North\":[\"East\",\"West\"],\"East\":[\"North\",\"South\"],\"West\":[\"North\",\"South\"]}",
              "requiredField": true
            }
          ]
        },
        "responseMode": "lastNode",
        "options": {
          "path": "cctv-investigation-intake"
        }
      },
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.6,
      "position": [
        416,
        240
      ],
      "id": "39450df8-dd95-4d99-9ba8-54adc967e2c2",
      "name": "On form submission",
      "webhookId": "2be4f6d6-4ca9-48d0-a3fa-800748b9799e"
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst case_id = String(input.case_id ?? '').trim();\nconst description = String(input.description ?? '').trim();\nconst initial_zone = String(input.initial_zone ?? '').trim();\nlet neighbors;\ntry { neighbors = JSON.parse(input.neighbors_json ?? ''); } catch { throw new Error('Jurisdiction adjacency map must be valid JSON.'); }\nif (!case_id || description.length < 3 || !initial_zone) throw new Error('Case ID, case description, and initial jurisdiction are required.');\nif (!neighbors || typeof neighbors !== 'object' || Array.isArray(neighbors)) throw new Error('Jurisdiction adjacency map must be a JSON object.');\nif (!Object.values(neighbors).every((zones) => Array.isArray(zones) && zones.every((zone) => typeof zone === 'string' && zone.trim()))) throw new Error('Each jurisdiction in the map must have an array of named neighboring jurisdictions.');\nconst directions = ['North', 'East', 'South', 'West'];\nif (!directions.every((zone) => Array.isArray(neighbors[zone]))) throw new Error('Define all four jurisdictions: North, East, South, and West.');\nif (!directions.includes(initial_zone)) throw new Error('Initial jurisdiction must be North, East, South, or West.');\nreturn [{ json: { case_id, description, initial_zone, neighbors } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        240
      ],
      "id": "2110a982-3c2d-4f50-af27-3c1c1824c06d",
      "name": "Validate Case Intake"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all().map((entry) => entry.json);\nif (!items.length) throw new Error('No directional work items were produced.');\nreturn [{ json: { case_id: items[0].case_id, items } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
