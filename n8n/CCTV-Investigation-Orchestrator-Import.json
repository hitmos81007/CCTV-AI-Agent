      "name": "Police Case Input"
    },
    {
      "parameters": {
        "jsCode": "const c = $input.first().json;\nconst neighborMap = c.neighbors || {};\nconst directions = ['North', 'East', 'South', 'West'];\nif (!directions.every((zone) => Array.isArray(neighborMap[zone]))) {\n  throw new Error('The four-direction search requires North, East, South, and West in the jurisdiction map.');\n}\nconst zones = directions;\nreturn [{ json: { ...c, investigation_plan: {\n  mode: 'synthetic_demo_only',\n  evidence_scope: 'people and common vehicles/objects; visible non-face attributes; human review required',\n  human_review_required: true,\n  zones_to_review: zones,\n  workers: zones.map((zone) => ({ worker_id: `zone_worker_${zone.toLowerCase()}`, jurisdiction: zone, status: 'awaiting_video_backend', candidate_sightings: [] })),\n  follow_up_zones: zones.filter((zone) => zone !== c.initial_zone),\n  sha256_integrity: 'computed_by_local_backend_when_evidence_is_attached'\n} } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        16
      ],
      "id": "f4dc2895-5581-4f68-baef-a23f6a4e170e",
      "name": "Investigation Planner (demo)"
    },
    {
      "parameters": {
        "jsCode": "const c = $input.first().json;\nconst plan = c.investigation_plan;\nconst videosByZone = new Map();\nfor (const video of c.registered_videos || []) {\n  if (!videosByZone.has(video.jurisdiction)) videosByZone.set(video.jurisdiction, []);\n  videosByZone.get(video.jurisdiction).push(video);\n}\nreturn plan.workers.flatMap((worker) => {\n  const zoneNeighbors = c.neighbors?.[worker.jurisdiction] || [];\n  const videos = videosByZone.get(worker.jurisdiction) || [];\n  const assignments = videos.length ? videos : [null];\n  return assignments.map((video) => ({ json: {\n    case_id: c.case_id,\n    worker_id: worker.worker_id,\n    jurisdiction: worker.jurisdiction,\n    status: video ? 'ready_for_analysis' : 'awaiting_local_video',\n    video_source_id: video?.video_source_id || null,\n    camera_id: video?.camera_id || null,\n    video_recorded_at: video?.recorded_at || null,\n    video_sha256: video?.sha256 || null,\n    description: c.description,\n    clue: c.clue || null,\n    neighbors: zoneNeighbors,\n    analysis_request: { description: c.description, clue: c.clue || null, attributes_only: true, exclude_face_identification: true },\n    candidate_sightings: [],\n    evidence_sha256: null,\n    human_review: { required: true, status: 'pending' },\n    follow_up_of: worker.jurisdiction === c.initial_zone ? null : c.initial_zone\n  } }));\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
