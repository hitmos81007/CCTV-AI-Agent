    {
      "parameters": {
        "authentication": "n8nUserAuth",
        "formTitle": "CCTV Investigation Case Intake",
        "formDescription": "Describe a visual clue in plain language. Search covers four directional jurisdictions: North, East, South, and West. Use visible non-face attributes; a human reviews candidate clips.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Case ID",
