APP_DATA_DIR=./data
# Set DATABASE_URL to a PostgreSQL URL to use PostgreSQL for application records.
# DATABASE_URL=postgresql://user:password@localhost:5432/cctv
HF_HOME=./data/model-cache
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:latest
YOLO_MODEL=yolo11n.pt
YOLO_DEVICE=auto
YOLO_CONFIDENCE=0.30
FOLLOWUP_MATCH_THRESHOLD=0.70
MAX_UPLOAD_MB=1024
VIDEO_WORKER_CONCURRENCY=1
CCTV_JOB_LEASE_SECONDS=900
CCTV_IMPORT_ROOTS=
CCTV_ALLOWED_RTSP_HOSTS=
FFPROBE_PATH=
REVIEW_USERNAME=
REVIEW_PASSWORD=
CORS_ALLOWED_ORIGINS=
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
